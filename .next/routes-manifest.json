{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/industries/[slug]",
      "regex": "^/industries/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/industries/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/industries/[slug]/[solutionSlug]",
      "regex": "^/industries/([^/]+?)/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug",
        "nxtPsolutionSlug": "nxtPsolutionSlug"
      },
      "namedRegex": "^/industries/(?<nxtPslug>[^/]+?)/(?<nxtPsolutionSlug>[^/]+?)(?:/)?$"
    },
    {
