4:["$","div",null,{"className":"space-y-4 text-white/60 text-lg leading-relaxed relative z-10","children":[["$","p","0",{"children":"Aura Fashion struggled deeply with siloed inventory data. The monolithic E-commerce system was entirely separate from the legacy in-store Point of Sale (POS) infrastructure."}],["$","p","1",{"children":"Online shoppers would frequently purchase out-of-stock items, while physical stores held surplus inventory in backrooms. This chaotic data split resulted in poor customer experiences, canceled orders, and millions in lost revenue potential."}]]}]
